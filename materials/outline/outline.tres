[gd_resource type="Shader" format=3 uid="uid://d1dpjqxnckplv"]

[resource]
code = "shader_type canvas_item;

uniform float saturation : hint_range(0.0, 1.0) = 1.0; // 0 - ч/б, 1 - оригинал

void fragment() {
    vec4 color = texture(TEXTURE, UV);
    // Рассчитываем яркость (luminance)
    float luminance = dot(color.rgb, vec3(0.299, 0.587, 0.114));
    // Смешиваем оригинал и ч/б версию
    vec3 gray = vec3(luminance);
    color.rgb = mix(gray, color.rgb, saturation);
    COLOR = color;
}
"
